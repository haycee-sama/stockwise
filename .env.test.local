# Test environment overrides. Vitest runs in `test` mode by default,
# so this file is loaded AFTER .env.local and overrides its values.
# Effect: tests always run in demo mode (no Supabase configured),
# regardless of whether the developer has a .env.local file with real
# credentials.
#
# This file IS committed (no secrets) — it only contains empty values.
# Tests that need to exercise Supabase mode should call
# `vi.stubEnv('VITE_SUPABASE_URL', '...')` + `vi.resetModules()` +
# `await import('...')` inside the test body.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=
VITE_ENABLE_NOTIFICATIONS=false
VITE_ENABLE_BULK_UPLOAD=false
VITE_ENABLE_PDF_EXPORT=false
