# Stockwise environment variables (sample).
#
# Copy this file to `.env.local` and fill in real values for local development.
# NEVER commit `.env.local` — it is gitignored by default.
#
# For tests, `.env.test.local` (committed) overrides these values to
# empty strings so the test suite runs in demo mode regardless of
# whether the developer has a .env.local configured.
#
# IMPORTANT — VITE_* variables are PUBLIC.
# Anything prefixed with VITE_ is shipped to the browser bundle and is
# therefore readable by anyone with access to the deployed site.
#
# Do NOT put secrets in VITE_* variables. Examples of things that must
# NEVER go here:
#   - Supabase service_role key
#   - Database password / connection string with credentials
#   - OAuth client secrets (Google, GitHub, etc.)
#   - Stripe secret key
#   - Sentry DSN with PII
#
# The Supabase publishable (anon) key below is designed to be public — it
# only works if Row Level Security (RLS) is enabled on every table. See
# docs/SUPABASE_SETUP.md for the full RLS plan.

# ── Supabase ──────────────────────────────────────────────
# Project URL (Dashboard → Project Settings → API → Project URL).
VITE_SUPABASE_URL=

# Publishable (anon) key (Dashboard → Project Settings → API → Project API keys → anon public).
# This is the PUBLIC key — safe for the browser. NEVER use the service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Application URL ───────────────────────────────────────
# The public-facing URL of the deployed app. Used as the redirect URL
# for password-reset emails. MUST be in the Supabase dashboard's
# Redirect URLs list (Auth → URL Configuration → Redirect URLs).
# - Dev:    http://localhost:5173
# - Prod:   https://stockwise-rho.vercel.app
VITE_PUBLIC_APP_URL=http://localhost:5173

# ── Optional REST API (future — not Supabase) ───────────
# Leave empty to disable the separate REST API client.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# ── Feature flags (all default to false in demo mode) ───
VITE_ENABLE_NOTIFICATIONS=false
VITE_ENABLE_BULK_UPLOAD=false
VITE_ENABLE_PDF_EXPORT=false
